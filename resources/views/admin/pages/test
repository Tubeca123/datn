  {
    id: 1,
    name: 'Paracetamol 500mg',
    brand: 'DHG Pharma',
    category: 'Giảm đau, hạ sốt',
    units: [
      { id: 1, unit_id: 1, unit_name: 'Viên', price_sale: 500, price_import: 300, quantity_per_unit: 1, stock: 5000 },
      { id: 2, unit_id: 2, unit_name: 'Vỉ', price_sale: 4500, price_import: 2700, quantity_per_unit: 10, stock: 500 },
      { id: 3, unit_id: 3, unit_name: 'Hộp', price_sale: 45000, price_import: 27000, quantity_per_unit: 100, stock: 50 }
    ]
  },
  {
    id: 2,
    name: 'Amoxicillin 500mg',
    brand: 'Traphaco',
    category: 'Kháng sinh',
    units: [
      { id: 4, unit_id: 1, unit_name: 'Viên', price_sale: 1200, price_import: 800, quantity_per_unit: 1, stock: 3000 },
      { id: 5, unit_id: 2, unit_name: 'Vỉ', price_sale: 11000, price_import: 7500, quantity_per_unit: 10, stock: 300 },
      { id: 6, unit_id: 3, unit_name: 'Hộp', price_sale: 100000, price_import: 70000, quantity_per_unit: 100, stock: 30 }
    ]
  },
  {
    id: 3,
    name: 'Vitamin C 1000mg',
    brand: 'Bayer',
    category: 'Vitamin & khoáng chất',
    units: [
      { id: 7, unit_id: 1, unit_name: 'Viên', price_sale: 2000, price_import: 1500, quantity_per_unit: 1, stock: 2000 },
      { id: 8, unit_id: 3, unit_name: 'Hộp', price_sale: 180000, price_import: 135000, quantity_per_unit: 100, stock: 20 }
    ]
  },
  {
    id: 4,
    name: 'Omeprazole 20mg',
    brand: 'Sanofi',
    category: 'Tiêu hóa',
    units: [
      { id: 9, unit_id: 1, unit_name: 'Viên', price_sale: 1500, price_import: 1000, quantity_per_unit: 1, stock: 1500 },
      { id: 10, unit_id: 2, unit_name: 'Vỉ', price_sale: 14000, price_import: 9500, quantity_per_unit: 10, stock: 150 }
    ]
  }
];

export default function PharmacyOrderUI() {
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [orderItems, setOrderItems] = useState([]);
  const [showProductList, setShowProductList] = useState(false);

  const filteredProducts = mockProducts.filter(product =>
    product.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    product.brand.toLowerCase().includes(searchTerm.toLowerCase())
  );

  const addToOrder = (product, unit, quantity) => {
    if (quantity <= 0) return;

    const existingItemIndex = orderItems.findIndex(
      item => item.product.id === product.id && item.unit.id === unit.id
    );

    if (existingItemIndex >= 0) {
      const newItems = [...orderItems];
      newItems[existingItemIndex].quantity += quantity;
      setOrderItems(newItems);
    } else {
      setOrderItems([...orderItems, {
        product,
        unit,
        quantity,
        total: unit.price_sale * quantity
      }]);
    }

    setSelectedProduct(null);
    setSearchTerm('');
  };

  const removeFromOrder = (index) => {
    setOrderItems(orderItems.filter((_, i) => i !== index));
  };

  const updateQuantity = (index, newQuantity) => {
    if (newQuantity <= 0) {
      removeFromOrder(index);
      return;
    }

    const newItems = [...orderItems];
    newItems[index].quantity = newQuantity;
    newItems[index].total = newItems[index].unit.price_sale * newQuantity;
    setOrderItems(newItems);
  };

  const calculateTotal = () => {
    return orderItems.reduce((sum, item) => sum + item.total, 0);
  };

  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('vi-VN', {
      style: 'currency',
      currency: 'VND'
    }).format(amount);
  };

  return (
    <div className="min-h-screen bg-gray-50 p-6">
      <div className="max-w-7xl mx-auto">
        <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
          <div className="flex items-center justify-between mb-6">
            <h1 className="text-3xl font-bold text-blue-600 flex items-center gap-2">
              <ShoppingCart className="w-8 h-8" />
              Tạo đơn bán thuốc
            </h1>
            <div className="text-right">
              <p className="text-sm text-gray-500">Ngày tạo</p>
              <p className="text-lg font-semibold">{new Date().toLocaleDateString('vi-VN')}</p>
            </div>
          </div>

          {/* Search Section */}
          <div className="relative mb-6">
            <div className="relative">
              <Search className="absolute left-3 top-3 w-5 h-5 text-gray-400" />
              <input
                type="text"
                placeholder="Tìm kiếm thuốc theo tên hoặc thương hiệu..."
                className="w-full pl-10 pr-4 py-3 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none text-lg"
                value={searchTerm}
                onChange={(e) => {
                  setSearchTerm(e.target.value);
                  setShowProductList(true);
                }}
                onFocus={() => setShowProductList(true)}
              />
            </div>

            {/* Product Search Results */}
            {showProductList && searchTerm && (
              <div className="absolute z-10 w-full mt-2 bg-white border-2 border-gray-200 rounded-lg shadow-xl max-h-96 overflow-y-auto">
                {filteredProducts.length > 0 ? (
                  filteredProducts.map(product => (
                    <div
                      key={product.id}
                      className="p-4 hover:bg-blue-50 cursor-pointer border-b last:border-b-0 transition"
                      onClick={() => {
                        setSelectedProduct(product);
                        setShowProductList(false);
                      }}
                    >
                      <div className="font-semibold text-lg text-gray-800">{product.name}</div>
                      <div className="text-sm text-gray-500 mt-1">
                        <span className="font-medium">{product.brand}</span> • {product.category}
                      </div>
                      <div className="text-xs text-blue-600 mt-1">
                        {product.units.length} đơn vị có sẵn
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="p-4 text-center text-gray-500">
                    Không tìm thấy thuốc phù hợp
                  </div>
                )}
              </div>
            )}
          </div>

          {/* Selected Product - Unit Selection */}
          {selectedProduct && (
            <ProductUnitSelector
              product={selectedProduct}
              onAdd={addToOrder}
              onCancel={() => setSelectedProduct(null)}
              formatCurrency={formatCurrency}
            />
          )}
        </div>

        {/* Order Items */}
        {orderItems.length > 0 && (
          <div className="bg-white rounded-lg shadow-lg p-6">
            <h2 className="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-2">
              <Package className="w-6 h-6" />
              Danh sách thuốc đã chọn
            </h2>

            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-gray-50 border-b-2 border-gray-200">
                  <tr>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">STT</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Tên thuốc</th>
                    <th className="px-4 py-3 text-left text-sm font-semibold text-gray-700">Đơn vị</th>
                    <th className="px-4 py-3 text-center text-sm font-semibold text-gray-700">Số lượng</th>
                    <th className="px-4 py-3 text-right text-sm font-semibold text-gray-700">Đơn giá</th>
                    <th className="px-4 py-3 text-right text-sm font-semibold text-gray-700">Thành tiền</th>
                    <th className="px-4 py-3 text-center text-sm font-semibold text-gray-700">Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {orderItems.map((item, index) => (
                    <tr key={index} className="border-b hover:bg-gray-50">
                      <td className="px-4 py-3 text-gray-700">{index + 1}</td>
                      <td className="px-4 py-3">
                        <div className="font-semibold text-gray-800">{item.product.name}</div>
                        <div className="text-xs text-gray-500">{item.product.brand}</div>
                      </td>
                      <td className="px-4 py-3">
                        <span className="px-2 py-1 bg-blue-100 text-blue-700 rounded text-sm font-medium">
                          {item.unit.unit_name}
                        </span>
                      </td>
                      <td className="px-4 py-3">
                        <input
                          type="number"
                          min="1"
                          value={item.quantity}
                          onChange={(e) => updateQuantity(index, parseInt(e.target.value) || 0)}
                          className="w-20 px-2 py-1 border border-gray-300 rounded text-center"
                        />
                      </td>
                      <td className="px-4 py-3 text-right font-medium">
                        {formatCurrency(item.unit.price_sale)}
                      </td>
                      <td className="px-4 py-3 text-right font-bold text-blue-600">
                        {formatCurrency(item.total)}
                      </td>
                      <td className="px-4 py-3 text-center">
                        <button
                          onClick={() => removeFromOrder(index)}
                          className="text-red-500 hover:text-red-700 p-2 hover:bg-red-50 rounded transition"
                        >
                          <Trash2 className="w-5 h-5" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Total */}
            <div className="mt-6 pt-6 border-t-2 border-gray-200">
              <div className="flex justify-between items-center">
                <div className="text-lg font-semibold text-gray-700">
                  Tổng số lượng: <span className="text-blue-600">{orderItems.length}</span> mặt hàng
                </div>
                <div className="text-right">
                  <div className="text-sm text-gray-500 mb-1">Tổng tiền</div>
                  <div className="text-3xl font-bold text-blue-600 flex items-center gap-2">
                    <DollarSign className="w-8 h-8" />
                    {formatCurrency(calculateTotal())}
                  </div>
                </div>
              </div>

              <div className="flex gap-4 mt-6">
                <button
                  onClick={() => {
                    if (confirm('Bạn có chắc muốn xóa toàn bộ đơn hàng?')) {
                      setOrderItems([]);
                    }
                  }}
                  className="flex-1 px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition"
                >
                  Hủy đơn
                </button>
                <button
                  onClick={() => {
                    alert('Chức năng lưu đơn hàng sẽ được triển khai!');
                    console.log('Order data:', orderItems);
                  }}
                  className="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition flex items-center justify-center gap-2"
                >
                  <ShoppingCart className="w-5 h-5" />
                  Tạo đơn hàng
                </button>
              </div>
            </div>
          </div>
        )}

        {orderItems.length === 0 && !selectedProduct && (
          <div className="bg-white rounded-lg shadow-lg p-12 text-center">
            <Package className="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <p className="text-gray-500 text-lg">Chưa có thuốc nào được chọn</p>
            <p className="text-gray-400 text-sm mt-2">Vui lòng tìm kiếm và chọn thuốc để bắt đầu tạo đơn</p>
          </div>
        )}
      </div>
    </div>
  );
}

function ProductUnitSelector({ product, onAdd, onCancel, formatCurrency }) {
  const [selectedUnit, setSelectedUnit] = useState(null);
  const [quantity, setQuantity] = useState(1);

  const handleAdd = () => {
    if (!selectedUnit || quantity <= 0) {
      alert('Vui lòng chọn đơn vị và nhập số lượng hợp lệ');
      return;
    }

    if (quantity > selectedUnit.stock) {
      alert(`Số lượng tồn kho không đủ! Còn lại: ${selectedUnit.stock} ${selectedUnit.unit_name}`);
      return;
    }

    onAdd(product, selectedUnit, quantity);
  };

  return (
    <div className="border-2 border-blue-200 rounded-lg p-6 bg-blue-50">
      <div className="flex justify-between items-start mb-4">
        <div>
          <h3 className="text-xl font-bold text-gray-800">{product.name}</h3>
          <p className="text-sm text-gray-600 mt-1">{product.brand} • {product.category}</p>
        </div>
        <button
          onClick={onCancel}
          className="text-gray-500 hover:text-gray-700 text-2xl leading-none"
        >
          ×
        </button>
      </div>

      <div className="mb-4">
        <label className="block text-sm font-semibold text-gray-700 mb-2">
          Chọn đơn vị thuốc
        </label>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
          {product.units.map(unit => (
            <div
              key={unit.id}
              onClick={() => setSelectedUnit(unit)}
              className={`p-4 border-2 rounded-lg cursor-pointer transition ${
                selectedUnit?.id === unit.id
                  ? 'border-blue-500 bg-blue-100'
                  : 'border-gray-300 bg-white hover:border-blue-300'
              }`}
            >
              <div className="font-bold text-lg text-gray-800">{unit.unit_name}</div>
              <div className="text-sm text-gray-600 mt-1">
                {unit.quantity_per_unit > 1 && (
                  <div>= {unit.quantity_per_unit} viên</div>
                )}
              </div>
              <div className="text-blue-600 font-semibold mt-2">
                {formatCurrency(unit.price_sale)}
              </div>
              <div className="text-xs text-gray-500 mt-1">
                Tồn: {unit.stock} {unit.unit_name}
              </div>
            </div>
          ))}
        </div>
      </div>

      {selectedUnit && (
        <div className="mb-4">
          <label className="block text-sm font-semibold text-gray-700 mb-2">
            Số lượng
          </label>
          <div className="flex gap-2 items-center">
            <button
              onClick={() => setQuantity(Math.max(1, quantity - 1))}
              className="w-10 h-10 bg-gray-200 hover:bg-gray-300 rounded-lg font-bold text-xl"
            >
              −
            </button>
            <input
              type="number"
              min="1"
              max={selectedUnit.stock}
              value={quantity}
              onChange={(e) => setQuantity(Math.max(1, parseInt(e.target.value) || 1))}
              className="flex-1 px-4 py-2 border-2 border-gray-300 rounded-lg text-center text-lg font-semibold"
            />
            <button
              onClick={() => setQuantity(Math.min(selectedUnit.stock, quantity + 1))}
              className="w-10 h-10 bg-gray-200 hover:bg-gray-300 rounded-lg font-bold text-xl"
            >
              +
            </button>
          </div>
          <div className="text-sm text-gray-600 mt-2">
            Tồn kho: {selectedUnit.stock} {selectedUnit.unit_name}
          </div>
        </div>
      )}

      {selectedUnit && (
        <div className="bg-white rounded-lg p-4 mb-4">
          <div className="flex justify-between items-center">
            <span className="text-gray-700 font-medium">Thành tiền:</span>
            <span className="text-2xl font-bold text-blue-600">
              {formatCurrency(selectedUnit.price_sale * quantity)}
            </span>
          </div>
        </div>
      )}

      <div className="flex gap-3">
        <button
          onClick={onCancel}
          className="flex-1 px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition"
        >
          Hủy
        </button>
        <button
          onClick={handleAdd}
          className="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition flex items-center justify-center gap-2"
        >
          <Plus className="w-5 h-5" />
          Thêm vào đơn
        </button>
      </div>
    </div>
  );
}